# Adapt certificate files and hostname; TLS and admin access control are required.
# Place inside the appropriate nginx http configuration; do not replace device PSK routing.
server {
    listen 443 ssl;
    server_name admin.example.com;
    ssl_certificate /etc/ssl/aiapp/fullchain.pem;
    ssl_certificate_key /etc/ssl/aiapp/privkey.pem;
    client_max_body_size 48m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
